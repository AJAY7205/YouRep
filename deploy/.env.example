# ==============================================================================
# YouRep Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' on your Azure VM and fill in real secrets.
# Do NOT commit your '.env' file containing actual passwords to GitHub!

# ------------------------------------------------------------------------------
# 1. Domain Settings
# ------------------------------------------------------------------------------
# Set this to your fully qualified Azure DNS name (e.g. yourep.eastus.cloudapp.azure.com)
DOMAIN_NAME=your-yourep-dns-label.cloudapp.azure.com

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL) Config
# ------------------------------------------------------------------------------
DB_NAME=Yourep
DB_USERNAME=postgres
# Change this to a strong, custom password (e.g. at least 16 random characters)
DB_PASSWORD=SuperStrongDbPasswordChangeMe123!

# ------------------------------------------------------------------------------
# 3. Object Storage (MinIO) Config
# ------------------------------------------------------------------------------
# MinIO root/admin credentials. Change these for production!
MINIO_ACCESS_KEY=minioadminprod
MINIO_SECRET_KEY=MinioAdminProdSecretChangeMe99!

# ------------------------------------------------------------------------------
# 4. Security & Authentication Config
# ------------------------------------------------------------------------------
# Secret key must be at least 256 bits (32 characters) long for HS256 algorithm.
# Generate a random 32-character or 64-character string.
JWT_SECRET=ProdJWTSecretMustBeAtLeast32CharactersLongChangeMeNow!
JWT_EXPIRATION_MS=86400000

# Hardcoded initial admin password. Change upon first login.
ADMIN_PASSWORD=Admin@ProdPassword123!

# ------------------------------------------------------------------------------
# 5. Email (Brevo) Config
# ------------------------------------------------------------------------------
# Get an API key from Brevo: Settings -> SMTP & API -> API keys.
# The sender email MUST be verified in Brevo before emails can be sent.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=yourep@yourdomain.com
BREVO_SENDER_NAME=YouRep

# ------------------------------------------------------------------------------
# 6. Account Verification
# ------------------------------------------------------------------------------
# Unverified accounts are deleted after this many days.
VERIFICATION_EXPIRY_DAYS=3
